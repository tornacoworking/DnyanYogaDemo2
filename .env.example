# .env.example
# Copy this file to ".env" and fill in the values:   cp .env.example .env
# ".env" is ignored by git, so your secrets never get uploaded. NEVER put real values in this file.
# On a hosting platform, add the same variables in the project's environment variable settings.

# ---------------------------------------------------------------------------
# Backend (Node.js + Express + MongoDB). Server only: never rename these to VITE_...,
# because VITE_ variables are copied into the browser code where anyone can read them.
# ---------------------------------------------------------------------------

# MongoDB connection string. Local MongoDB:      mongodb://127.0.0.1:27017/dnyanyoga
# MongoDB Atlas (cloud):  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dnyanyoga?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/dnyanyoga

# Port the Express server listens on. (`npm run dev` forwards /api requests to this port.)
PORT=5000

# Secret for the admin endpoints that list / update / delete saved enquiries
# (GET/PATCH/DELETE /api/enquiries, /api/applications, /api/subscribers).
# Send it in the "x-api-key" header. Leave empty to switch those endpoints off.
# Use a long random value, e.g. run:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Only when the server runs behind a proxy / load balancer (so rate limiting sees the real visitor IP).
# Use 1 for one proxy, or leave empty when the server is reached directly.
TRUST_PROXY=

# ---------------------------------------------------------------------------
# Frontend (safe to be public)
# ---------------------------------------------------------------------------

# The live website address, without a trailing slash. Overrides siteUrl in src/data/site.js.
# Used for canonical URLs, social sharing tags and the sitemap.
VITE_SITE_URL=https://DnyanYoga.com
